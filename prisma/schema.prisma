model OrderEmailDelivery {
  id                   String                   @id @db.Char(36)
  orderId              String                   @map("order_id") @db.Char(36)
  status               OrderEmailDeliveryStatus @default(PENDING)
  toRecipients         Json                     @map("to_recipients")
  fromAddress          String                   @map("from_address") @db.VarChar(254)
  fromName             String?                  @map("from_name") @db.VarChar(120)
  replyTo              String?                  @map("reply_to") @db.VarChar(254)
  templateVersion      String                   @map("template_version") @db.VarChar(32)
  idempotencyKey       String                   @unique @map("idempotency_key") @db.VarChar(128)
  contentHash          String                   @map("content_hash") @db.Char(64)
  provider             String?                  @db.VarChar(64)
  providerMessageId    String?                  @map("provider_message_id") @db.VarChar(255)
  attemptCount         Int                      @default(0) @map("attempt_count") @db.UnsignedSmallInt
  nextAttemptAt        DateTime                 @map("next_attempt_at") @db.DateTime(3)
  reservationToken     String?                  @map("reservation_token") @db.VarChar(64)
  processingStartedAt  DateTime?                @map("processing_started_at") @db.DateTime(3)
  reservationExpiresAt DateTime?                @map("reservation_expires_at") @db.DateTime(3)
  publicError          String?                  @map("public_error") @db.VarChar(255)
  technicalErrorCode   String?                  @map("technical_error_code") @db.VarChar(80)
  acceptedAt           DateTime?                @map("accepted_at") @db.DateTime(3)
  deliveredAt          DateTime?                @map("delivered_at") @db.DateTime(3)
  failedAt             DateTime?                @map("failed_at") @db.DateTime(3)
  bouncedAt            DateTime?                @map("bounced_at") @db.DateTime(3)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  order                Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt])
  @@index([status, reservationExpiresAt])
  @@index([orderId, createdAt])
  @@index([provider, providerMessageId])
  @@map("order_email_deliveries")
}
