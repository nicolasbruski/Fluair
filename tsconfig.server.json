{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/server/**/*.ts", "src/server/**/*.d.ts", "src/shared/**/*.ts"],
  "exclude": ["tests", "dist", "node_modules"]
}
